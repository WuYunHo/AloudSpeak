    },
    {
      "id": 15059,
      "start": 165.96,
      "end": 167.36,
      "text": "你也是同一個Leon",
      "translation": ""
    },
    {
      "id": 15060,
      "start": 167.36,
      "end": 169.76,
      "text": "那四個主題究竟是可以怎樣玩",
