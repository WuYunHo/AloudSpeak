      "end": 283.46,
      "text": "我們都希望聽很多舊的歌",
      "translation": ""
    },
    {
      "id": 15112,
      "start": 283.46,
      "end": 286.52,
      "text": "你叫雷仲德寫新歌出來",
      "translation": ""
    },
    {
      "id": 15113,
      "start": 286.52,
      "end": 287.8,
      "text": "我寫包單",
      "translation": ""
    },
    {
      "id": 15114,
      "start": 287.8,
      "end": 289.34,
      "text": "你叫他寫完出來",
      "translation": ""
    },
    {
      "id": 15115,
      "start": 289.34,
