      "text": "大家投票了",
      "translation": ""
    },
    {
      "id": 15116,
      "start": 290.88,
      "end": 291.9,
      "text": "什麼事",
      "translation": ""
    },
    {
      "id": 15117,
      "start": 291.9,
      "end": 292.92,
      "text": "投什麼事",
      "translation": ""
    },
    {
      "id": 15118,
      "start": 292.92,
      "end": 294.46,
      "text": "終於舊還是新",
      "translation": ""
    },
    {
      "id": 15119,
      "start": 294.46,
      "end": 296.76,
      "text": "意思應該都是",
      "translation": ""
    },
    {
      "id": 15120,
      "start": 296.76,
      "end": 298.04,
      "text": "不要搞新事了",
      "translation": ""
    },
    {
      "id": 15121,
      "start": 298.04,
      "end": 299.84,
      "text": "我也覺得是",
      "translation": ""
    },
    {
      "id": 15122,
      "start": 299.84,
      "end": 301.88,
      "text": "有新事物一早就給你",
      "translation": ""
    },
    {
      "id": 15123,
      "start": 301.88,
      "end": 303.68,
      "text": "你不會等你叫才給",
      "translation": ""
    },
    {
      "id": 15124,
