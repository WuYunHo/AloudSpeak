    },
    {
      "id": 15053,
      "start": 146.78,
      "end": 149.84,
      "text": "主題叫做4D",
      "translation": ""
    },
    {
      "id": 15054,
      "start": 149.84,
      "end": 152.48,
      "text": "聽説場館分成四拍",
      "translation": ""
    },
    {
      "id": 15055,
      "start": 152.48,
      "end": 155.78,
      "text": "以Leon的LEON四個不同主題",
      "translation": ""
    },
    {
      "id": 15056,
      "start": 155.78,
      "end": 159.12,
      "text": "例如有Love、激情、Night Horror",
      "translation": ""
    },
    {
      "id": 15057,
      "start": 159.12,
      "end": 162.96,
      "text": "大家也期待有什麼是",
      "translation": ""
    },
    {
      "id": 15058,
      "start": 162.96,
      "end": 165.96,
      "text": "演唱會就算是四面台",
