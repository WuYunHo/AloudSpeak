    },
    {
      "id": 15034,
      "start": 80,
      "end": 82,
      "text": "點解今年要開呢",
      "translation": ""
    },
    {
      "id": 15035,
      "start": 82,
      "end": 87,
      "text": "今年開番係因為我哋頭先有同事説開",
      "translation": ""
    },
    {
      "id": 15036,
      "start": 87,
      "end": 90,
      "text": "他説紅館新鮮期都滿了紙",
      "translation": ""
    },
    {
      "id": 15037,
      "start": 90,
      "end": 95,
      "text": "譬如新海濱那邊好像還有一年多",
