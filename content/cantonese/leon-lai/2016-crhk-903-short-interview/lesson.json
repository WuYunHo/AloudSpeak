    },
    {
      "id": 15080,
      "start": 211.44,
      "end": 213.44,
      "text": "音樂的過程裏",
      "translation": ""
    },
    {
      "id": 15081,
      "start": 213.44,
      "end": 215.84,
      "text": "現在是很多時候在香港樂壇裏",
