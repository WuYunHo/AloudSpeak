    },
    {
      "id": 15083,
      "start": 217.16,
      "end": 219.24,
      "text": "但可能對其他人會不公平",
      "translation": ""
    },
    {
      "id": 15084,
      "start": 219.24,
      "end": 221.24,
      "text": "其實自己後輪根本沒有著火",
      "translation": ""
    },
    {
      "id": 15085,
      "start": 221.24,
      "end": 223.24,
      "text": "但覺得自己後輪著火",
      "translation": ""
    },
    {
      "id": 15086,
      "start": 223.24,
      "end": 226.24,
      "text": "人家叫做事時就想著自己後輪",
      "translation": ""
    },
    {
      "id": 15087,
      "start": 226.24,
      "end": 229.24,
      "text": "變成做事時很難專注",
