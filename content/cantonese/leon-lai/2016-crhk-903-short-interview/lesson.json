    },
    {
      "id": 15051,
      "start": 139.64,
      "end": 143.1,
      "text": "不需要戴眼鏡的3D效果",
      "translation": ""
    },
    {
      "id": 15052,
      "start": 143.1,
      "end": 146.78,
      "text": "還有有稀味的",
