    },
    {
      "id": 15061,
      "start": 169.76,
      "end": 171.36,
      "text": "其實大家都很興奮",
      "translation": ""
    },
    {
      "id": 15062,
      "start": 171.36,
      "end": 176.16,
      "text": "這個Facebook是否你自己會上傳一些東西",
