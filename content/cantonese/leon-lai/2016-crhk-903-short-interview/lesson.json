{
  "id": "leon-lai-2016-crhk-903-short-interview",
  "title": "黎明叱咤 903 電台訪問（短版）",
  "speaker": "黎明（Leon Lai）",
  "category": "粵語訪談",
  "level": "粵語",
  "minutes": 6,
  "sourceUrl": "https://www.bilibili.com/video/BV11T4y1A7Su/",
  "segments": [
    {
      "id": 15001,
      "start": 0,
      "end": 4,
      "text": "口水多過浪花，老友記時間",
      "translation": "口水多过浪花，老友记时间"
    },
    {
      "id": 15002,
      "start": 8,
      "end": 10,
      "text": "今日嘅老友記係",
      "translation": "今天的老友记系"
    },
    {
      "id": 15003,
      "start": 15,
      "end": 17,
      "text": "Leon，嚟喇",
      "translation": "Leon，来了"
    },
    {
      "id": 15004,
      "start": 17,
      "end": 19,
      "text": "謝謝你，好開心",
      "translation": "谢谢你，好开心"
    },
    {
      "id": 15005,
      "start": 19,
      "end": 22,
      "text": "因為我哋經常希望訪問你",
      "translation": "因为我们经常希望访问你"
    },
    {
      "id": 15006,
      "start": 22,
      "end": 24,
      "text": "大話都講咗幾年喇",
      "translation": "大话都说了几年了"
    },
    {
      "id": 15007,
      "start": 24,
      "end": 25,
      "text": "係嗎？",
      "translation": "系吗？"
    },
    {
      "id": 15008,
      "start": 25,
      "end": 27,
      "text": "又未開始做節目",
      "translation": "又未开始做节目"
    },
    {
      "id": 15009,
      "start": 27,
      "end": 28,
      "text": "係嗎？",
      "translation": "系吗？"
    },
    {
      "id": 15010,
      "start": 28,
      "end": 31,
      "text": "Leon 終於等到今日喇",
      "translation": "Leon 终于等到今天了"
    },
    {
      "id": 15011,
      "start": 31,
      "end": 33.76,
      "text": "我頭先問問Leon",
      "translation": "我刚才问问Leon"
    },
    {
      "id": 15012,
      "start": 33.76,
      "end": 36.76,
      "text": "你幾耐冇上電台訪問",
      "translation": "你几耐没有上电台访问"
    },
    {
      "id": 15013,
      "start": 36.76,
      "end": 38,
      "text": "我都唔記得咗",
      "translation": "我都唔记得了"
    },
    {
      "id": 15014,
      "start": 38,
      "end": 40,
      "text": "真係畀面",
      "translation": "真的给面"
    },
    {
      "id": 15015,
      "start": 40,
      "end": 41,
      "text": "唔係畀面",
      "translation": "不是给面"
    },
    {
      "id": 15016,
      "start": 41,
      "end": 43,
      "text": "唔能夠這樣説緣份",
      "translation": "不能这样说缘份"
    },
    {
      "id": 15017,
      "start": 43,
      "end": 44,
      "text": "謝謝",
      "translation": "谢谢"
    },
    {
      "id": 15018,
      "start": 44,
      "end": 47,
      "text": "謝謝雄福見到Leon好開心",
      "translation": "谢谢雄福看见Leon好开心"
    },
    {
      "id": 15019,
      "start": 47,
      "end": 48,
      "text": "好明顯",
      "translation": "好明显"
    },
    {
      "id": 15020,
      "start": 48,
      "end": 49,
      "text": "那其實",
      "translation": "那其实"
    },
    {
      "id": 15021,
      "start": 49,
      "end": 51,
      "text": "我以前好不畀面",
      "translation": "我以前好不给面"
    },
    {
      "id": 15022,
      "start": 51,
      "end": 53,
      "text": "Leon演唱會咗",
      "translation": "Leon演唱会了"
    },
    {
      "id": 15023,
      "start": 53,
      "end": 56,
      "text": "其實也不用做宣傳",
      "translation": "其实也不用做宣传"
    },
    {
      "id": 15024,
      "start": 56,
      "end": 58,
      "text": "係不用全靠咗",
      "translation": "系不用全靠了"
    },
    {
      "id": 15025,
      "start": 58,
      "end": 61,
      "text": "都還沒説on已經賣了票",
      "translation": "都还没说on已经卖了票"
    },
    {
      "id": 15026,
      "start": 61,
      "end": 64,
      "text": "唔知還沒開才賣",
      "translation": "不知道还没开才卖"
    },
    {
      "id": 15027,
      "start": 64,
      "end": 67,
      "text": "不用宣傳咗 今日係特意上來",
      "translation": "不用宣传了 今天系特意上来"
    },
    {
      "id": 15028,
      "start": 67,
      "end": 68,
      "text": "見一下Do Jelly",
      "translation": "见一下Do Jelly"
    },
    {
      "id": 15029,
      "start": 68,
      "end": 69,
      "text": "謝謝",
      "translation": "谢谢"
    },
    {
      "id": 15030,
      "start": 69,
      "end": 73,
      "text": "要的 也不可以咁離譜",
      "translation": "要的 也不可以这么离谱"
    },
    {
      "id": 15031,
      "start": 73,
      "end": 76,
      "text": "演唱會多久冇開咗",
      "translation": "演唱会多久没有开了"
    },
    {
      "id": 15032,
      "start": 76,
      "end": 78,
      "text": "好像有五六年吧",
      "translation": "好像有五六年吧"
    },
    {
      "id": 15033,
      "start": 78,
      "end": 80,
      "text": "五六年咗 有咗",
      "translation": "五六年了 有了"
    },
    {
      "id": 15034,
      "start": 80,
      "end": 82,
      "text": "點解今年要開呢",
      "translation": "为什么今年要开呢"
    },
    {
      "id": 15035,
      "start": 82,
      "end": 87,
      "text": "今年開番係因為我哋頭先有同事説開",
      "translation": "今年开番系因为我们刚才有同事说开"
    },
    {
      "id": 15036,
      "start": 87,
      "end": 90,
      "text": "他説紅館新鮮期都滿了紙",
      "translation": "他说红馆新鲜期都满了纸"
    },
    {
      "id": 15037,
      "start": 90,
      "end": 95,
      "text": "譬如新海濱那邊好像還有一年多",
      "translation": "譬如新海滨那边好像还有一年多"
    },
    {
      "id": 15038,
      "start": 95,
      "end": 97,
      "text": "就變成給政府",
      "translation": "就变成给政府"
    },
    {
      "id": 15039,
      "start": 97,
      "end": 102,
      "text": "剛剛有個期就問我哋想想怎樣做",
      "translation": "刚刚有个期就问我们想想怎样做"
    },
    {
      "id": 15040,
      "start": 102,
      "end": 106,
      "text": "有啲人給了一些創業出來",
      "translation": "有些人给了一些创业出来"
    },
    {
      "id": 15041,
      "start": 106,
      "end": 111,
      "text": "喺外國好多嗰陣時都會用一些好大的恆温dorm",
      "translation": "在外国很多那时候都会用一些好大的恒温dorm"
    },
    {
      "id": 15042,
      "start": 111,
      "end": 115.16,
      "text": "建立後就被人坐",
      "translation": "建立后就被人坐"
    },
    {
      "id": 15043,
      "start": 115.16,
      "end": 117.8,
      "text": "所以變成一個dorm的尺寸就唔能夠太大",
      "translation": "所以变成一个dorm的尺寸就不能太大"
    },
    {
      "id": 15044,
      "start": 117.8,
      "end": 121.24,
      "text": "只能夠為了一千人左右就變成一塊",
      "translation": "只能够为了一千人左右就变成一块"
    },
    {
      "id": 15045,
      "start": 121.24,
      "end": 123,
      "text": "變成舞台中間嗰陣時",
      "translation": "变成舞台中间那时候"
    },
    {
      "id": 15046,
      "start": 123,
      "end": 129,
      "text": "如果你要做3D mapping和Fisual有關的嘢",
      "translation": "如果你要做3D mapping和Fisual有关的东西"
    },
    {
      "id": 15047,
      "start": 129,
      "end": 131.48,
      "text": "其實人太多你也係做不到的",
      "translation": "其实人太多你也系做不到的"
    },
    {
      "id": 15048,
      "start": 131.48,
      "end": 134.6,
      "text": "例如紅館你不可以喺旁邊間隔位置",
      "translation": "例如红馆你不可以在旁边间隔位置"
    },
    {
      "id": 15049,
      "start": 134.6,
      "end": 135.96,
      "text": "隔位置給人睇嘢",
      "translation": "隔位置给人看东西"
    },
    {
      "id": 15050,
      "start": 135.96,
      "end": 139.64,
      "text": "剛剛喺呢個設計裏做了我哋想做的一個",
      "translation": "刚刚在这个设计里做了我们想做的一个"
    },
    {
      "id": 15051,
      "start": 139.64,
      "end": 143.1,
      "text": "唔使戴眼鏡的3D效果",
      "translation": "不需要戴眼镜的3D效果"
    },
    {
      "id": 15052,
      "start": 143.1,
      "end": 146.78,
      "text": "還有有稀味的",
      "translation": "还有有稀味的"
    },
    {
      "id": 15053,
      "start": 146.78,
      "end": 149.84,
      "text": "主題叫做4D",
      "translation": "主题叫做4D"
    },
    {
      "id": 15054,
      "start": 149.84,
      "end": 152.48,
      "text": "聽説場館分成四拍",
      "translation": "听说场馆分成四拍"
    },
    {
      "id": 15055,
      "start": 152.48,
      "end": 155.78,
      "text": "以Leon的LEON四個唔同主題",
      "translation": "以Leon的LEON四个不同主题"
    },
    {
      "id": 15056,
      "start": 155.78,
      "end": 159.12,
      "text": "例如有Love、激情、Night Horror",
      "translation": "例如有Love、激情、Night Horror"
    },
    {
      "id": 15057,
      "start": 159.12,
      "end": 162.96,
      "text": "大家也期待有乜嘢係",
      "translation": "大家也期待有什么系"
    },
    {
      "id": 15058,
      "start": 162.96,
      "end": 165.96,
      "text": "演唱會就算係四面台",
      "translation": "演唱会就算系四面台"
    },
    {
      "id": 15059,
      "start": 165.96,
      "end": 167.36,
      "text": "你也係同一個Leon",
      "translation": "你也系同一个Leon"
    },
    {
      "id": 15060,
      "start": 167.36,
      "end": 169.76,
      "text": "那四個主題究竟係可以怎樣玩",
      "translation": "那四个主题究竟系可以怎样玩"
    },
    {
      "id": 15061,
      "start": 169.76,
      "end": 171.36,
      "text": "其實大家都好興奮",
      "translation": "其实大家都好兴奋"
    },
    {
      "id": 15062,
      "start": 171.36,
      "end": 176.16,
      "text": "呢個Facebook係否你自己會上傳一些嘢",
      "translation": "这个Facebook系否你自己会上传一些东西"
    },
    {
      "id": 15063,
      "start": 176.16,
      "end": 178.16,
      "text": "或係你外面唔係説話",
      "translation": "或是你外面不是说话"
    },
    {
      "id": 15064,
      "start": 178.16,
      "end": 179.76,
      "text": "有好多助理喺嗰度",
      "translation": "有很多助理在那里"
    },
    {
      "id": 15065,
      "start": 179.76,
      "end": 181.76,
      "text": "係否佢哋幫你 或係你自己做的",
      "translation": "系否他们帮你 或是你自己做的"
    },
    {
      "id": 15066,
      "start": 181.76,
      "end": 183.76,
      "text": "通常的素材係我放上去的",
      "translation": "通常的素材是我放上去的"
    },
    {
      "id": 15067,
      "start": 183.76,
      "end": 185.76,
      "text": "素材係我自己想的",
      "translation": "素材是我自己想的"
    },
    {
      "id": 15068,
      "start": 185.76,
      "end": 187.76,
      "text": "好少人會幫我",
      "translation": "好少人会帮我"
    },
    {
      "id": 15069,
      "start": 187.76,
      "end": 189.36,
      "text": "因為想完之後未必係你的嘢",
      "translation": "因为想完之后未必是你的东西"
    },
    {
      "id": 15070,
      "start": 189.36,
      "end": 193.2,
      "text": "為何等到今時今日才可以開呢個Facebook的項目",
      "translation": "为何等到今时今天才可以开这个Facebook的项目"
    },
    {
      "id": 15071,
      "start": 193.2,
      "end": 195.36,
      "text": "呢個世界上有啲人反應好快",
      "translation": "这个世界上有些人反应好快"
    },
    {
      "id": 15072,
      "start": 195.36,
      "end": 196.84,
      "text": "有啲人反應好慢",
      "translation": "有些人反应好慢"
    },
    {
      "id": 15073,
      "start": 196.84,
      "end": 198.84,
      "text": "我就屬於最慢的嗰一種",
      "translation": "我就属于最慢的那一种"
    },
    {
      "id": 15074,
      "start": 198.84,
      "end": 200.84,
      "text": "我今日代到第一句金句",
      "translation": "我今天代到第一句金句"
    },
    {
      "id": 15075,
      "start": 200.84,
      "end": 202.68,
      "text": "好開心",
      "translation": "好开心"
    },
    {
      "id": 15076,
      "start": 202.68,
      "end": 205.24,
      "text": "而家呢個人對音樂",
      "translation": "现在这个人对音乐"
    },
    {
      "id": 15077,
      "start": 205.24,
      "end": 207.72,
      "text": "係唔係還有那股熱情喺這裏",
      "translation": "系不是还有那股热情在这里"
    },
    {
      "id": 15078,
      "start": 207.72,
      "end": 209.56,
      "text": "我對音樂一向都有熱情",
      "translation": "我对音乐一向都有热情"
    },
    {
      "id": 15079,
      "start": 209.56,
      "end": 211.44,
      "text": "你好鍾意音樂",
      "translation": "你好喜欢音乐"
    },
    {
      "id": 15080,
      "start": 211.44,
      "end": 213.44,
      "text": "音樂的過程裏",
      "translation": "音乐的过程里"
    },
    {
      "id": 15081,
      "start": 213.44,
      "end": 215.84,
      "text": "而家係好多嗰陣時喺香港樂壇裏",
      "translation": "现在系很多那时候在香港乐坛里"
    },
    {
      "id": 15082,
      "start": 215.84,
      "end": 217.16,
      "text": "我直説我的感受",
      "translation": "我直说我的感受"
    },
    {
      "id": 15083,
      "start": 217.16,
      "end": 219.24,
      "text": "但可能對其他人會不公平",
      "translation": "但可能对其他人会不公平"
    },
    {
      "id": 15084,
      "start": 219.24,
      "end": 221.24,
      "text": "其實自己後輪根本冇著火",
      "translation": "其实自己后轮根本没有著火"
    },
    {
      "id": 15085,
      "start": 221.24,
      "end": 223.24,
      "text": "但覺得自己後輪著火",
      "translation": "但觉得自己后轮著火"
    },
    {
      "id": 15086,
      "start": 223.24,
      "end": 226.24,
      "text": "人家叫做事時就想著自己後輪",
      "translation": "人家叫做事时就想著自己后轮"
    },
    {
      "id": 15087,
      "start": 226.24,
      "end": 229.24,
      "text": "變成做事時好難專注",
      "translation": "变成做事时好难专注"
    },
    {
      "id": 15088,
      "start": 229.24,
      "end": 233.24,
      "text": "有時做事靈感和集中度",
      "translation": "有时做事灵感和集中度"
    },
    {
      "id": 15089,
      "start": 233.24,
      "end": 235.24,
      "text": "其實只係集中四天搞定",
      "translation": "其实只系集中四天搞定"
    },
    {
      "id": 15090,
      "start": 235.24,
      "end": 237.24,
      "text": "但你整個人都覺得後輪著火",
      "translation": "但你整个人都觉得后轮著火"
    },
    {
      "id": 15091,
      "start": 237.24,
      "end": 239.24,
      "text": "嗰度少了一隻羊、少了一隻牛",
      "translation": "那里少了一只羊、少了一只牛"
    },
    {
      "id": 15092,
      "start": 239.24,
      "end": 241.24,
      "text": "你好難專注到做事",
      "translation": "你好难专注到做事"
    },
    {
      "id": 15093,
      "start": 241.24,
      "end": 243.24,
      "text": "有冇新歌？",
      "translation": "有没有新歌？"
    },
    {
      "id": 15094,
      "start": 243.24,
      "end": 245.24,
      "text": "我想新歌都會有啲",
      "translation": "我想新歌都会有些"
    },
    {
      "id": 15095,
      "start": 245.24,
      "end": 247.24,
      "text": "但如果而家做新歌就冇咗",
      "translation": "但如果现在做新歌就没有了"
    },
    {
      "id": 15096,
      "start": 247.24,
      "end": 252.24,
      "text": "你自己得不得閒呢",
      "translation": "你自己得不得闲呢"
    },
    {
      "id": 15097,
      "start": 252.24,
      "end": 255.24,
      "text": "我有好聽的歌 我根本三個小時不用錄咗",
      "translation": "我有好听的歌 我根本三个小时不用录了"
    },
    {
      "id": 15098,
      "start": 255.24,
      "end": 258.24,
      "text": "以我今日的促藝",
      "translation": "以我今天的促艺"
    },
    {
      "id": 15099,
      "start": 258.24,
      "end": 262.24,
      "text": "我冇退步 我計算有進步",
      "translation": "我没有退步 我计算有进步"
    },
    {
      "id": 15100,
      "start": 262.24,
      "end": 263.24,
      "text": "我唱K",
      "translation": "我唱K"
    },
    {
      "id": 15101,
      "start": 263.24,
      "end": 266.24,
      "text": "你一叫他 他立刻畀你吧",
      "translation": "你一叫他 他立刻给你吧"
    },
    {
      "id": 15102,
      "start": 266.24,
      "end": 268.24,
      "text": "嗰啲填詞人 我想也係三個小時之內",
      "translation": "那些填词人 我想也系三个小时之内"
    },
    {
      "id": 15103,
      "start": 268.24,
      "end": 270.24,
      "text": "林夕係消失的",
      "translation": "林夕系消失的"
    },
    {
      "id": 15104,
      "start": 270.24,
      "end": 271.24,
      "text": "聽我的電話",
      "translation": "听我的电话"
    },
    {
      "id": 15105,
      "start": 271.24,
      "end": 273.24,
      "text": "消失的填詞人",
      "translation": "消失的填词人"
    },
    {
      "id": 15106,
      "start": 273.24,
      "end": 274.24,
      "text": "唔係消失的我人",
      "translation": "不是消失的我人"
    },
    {
      "id": 15107,
      "start": 274.24,
      "end": 275.52,
      "text": "傑仁之人",
      "translation": "杰仁之人"
    },
    {
      "id": 15108,
      "start": 275.52,
      "end": 277.32,
      "text": "雷仲德打麻雀就回覆",
      "translation": "雷仲德打麻雀就回复"
    },
    {
      "id": 15109,
      "start": 277.32,
      "end": 278.34,
      "text": "我的嗰啲不回覆",
      "translation": "我的那些不回复"
    },
    {
      "id": 15110,
      "start": 278.34,
      "end": 280.9,
      "text": "老實説 如果黎明鏗演唱會",
      "translation": "老实说 如果黎明铿演唱会"
    },
    {
      "id": 15111,
      "start": 280.9,
      "end": 283.46,
      "text": "我哋都希望聽好多舊嘅歌",
      "translation": "我们都希望听很多旧的歌"
    },
    {
      "id": 15112,
      "start": 283.46,
      "end": 286.52,
      "text": "你叫雷仲德寫新歌出來",
      "translation": "你叫雷仲德写新歌出来"
    },
    {
      "id": 15113,
      "start": 286.52,
      "end": 287.8,
      "text": "我寫包單",
      "translation": "我写包单"
    },
    {
      "id": 15114,
      "start": 287.8,
      "end": 289.34,
      "text": "你叫他寫完出來",
      "translation": "你叫他写完出来"
    },
    {
      "id": 15115,
      "start": 289.34,
      "end": 290.88,
      "text": "大家投票咗",
      "translation": "大家投票了"
    },
    {
      "id": 15116,
      "start": 290.88,
      "end": 291.9,
      "text": "乜嘢事",
      "translation": "什么事"
    },
    {
      "id": 15117,
      "start": 291.9,
      "end": 292.92,
      "text": "投乜嘢事",
      "translation": "投什么事"
    },
    {
      "id": 15118,
      "start": 292.92,
      "end": 294.46,
      "text": "終於舊還係新",
      "translation": "终于旧还系新"
    },
    {
      "id": 15119,
      "start": 294.46,
      "end": 296.76,
      "text": "意思應該都係",
      "translation": "意思应该都系"
    },
    {
      "id": 15120,
      "start": 296.76,
      "end": 298.04,
      "text": "唔好搞新事咗",
      "translation": "不要搞新事了"
    },
    {
      "id": 15121,
      "start": 298.04,
      "end": 299.84,
      "text": "我也覺得係",
      "translation": "我也觉得系"
    },
    {
      "id": 15122,
      "start": 299.84,
      "end": 301.88,
      "text": "有新事物一早就畀你",
      "translation": "有新事物一早就给你"
    },
    {
      "id": 15123,
      "start": 301.88,
      "end": 303.68,
      "text": "你唔會等你叫才給",
      "translation": "你不会等你叫才给"
    },
    {
      "id": 15124,
      "start": 303.68,
      "end": 308.44,
      "text": "你明白乜嘢 好多嗰陣時等你叫才讓老夫老車離婚",
      "translation": "你明白什么 很多那时候等你叫才让老夫老车离婚"
    },
    {
      "id": 15125,
      "start": 308.44,
      "end": 312.68,
      "text": "對 作歌人聽到咗 如果有好嘢",
      "translation": "对 作歌人听到了 如果有好东西"
    },
    {
      "id": 15126,
      "start": 312.68,
      "end": 315.92,
      "text": "自動自覺 人的情緒係否想説",
      "translation": "自动自觉 人的情绪系否想说"
    },
    {
      "id": 15127,
      "start": 315.92,
      "end": 320.2,
      "text": "你喝杯湯畀我喝 説當你口乾",
      "translation": "你喝杯汤给我喝 说当你口干"
    },
    {
      "id": 15128,
      "start": 320.2,
      "end": 322.44,
      "text": "突然有人又拿出來",
      "translation": "突然有人又拿出来"
    },
    {
      "id": 15129,
      "start": 322.44,
      "end": 324.6,
      "text": "突然有人喝杯湯畀你 呢個人真好",
      "translation": "突然有人喝杯汤给你 这个人真好"
    },
    {
      "id": 15130,
      "start": 324.6,
      "end": 328.68,
      "text": "我挺鍾意和黎明傾偈 他真係有那句説",
      "translation": "我挺喜欢和黎明聊天 他真的有那句说"
    },
    {
      "id": 15131,
      "start": 328.68,
      "end": 332.68,
      "text": "唔能夠説的 都説咗",
      "translation": "不能说的 都说了"
    },
    {
      "id": 15132,
      "start": 332.68,
      "end": 334.68,
      "text": "沒乜嘢唔能夠説的",
      "translation": "没什么不能说的"
    },
    {
      "id": 15133,
      "start": 334.68,
      "end": 338.02,
      "text": "這條命係咁多的咗",
      "translation": "这条命系这么多的了"
    }
  ]
}
