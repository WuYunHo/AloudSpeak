				"to": 193200
			},
			"text": "為何等到今時今日才可以開這個Facebook的項目"
		},
		{
			"timestamps": {
				"from": "00:03:13,200",
				"to": "00:03:15,360"
			},
			"offsets": {
				"from": 193200,
				"to": 195360
			},
			"text": "這個世界上有些人反應很快"
		},
		{
			"timestamps": {
				"from": "00:03:15,360",
				"to": "00:03:16,840"
			},
			"offsets": {
				"from": 195360,
				"to": 196840
			},
			"text": "有些人反應很慢"
		},
		{
			"timestamps": {
				"from": "00:03:16,840",
				"to": "00:03:18,840"
			},
			"offsets": {
				"from": 196840,
				"to": 198840
			},
			"text": "我就屬於最慢的那一種"
		},
		{
			"timestamps": {
				"from": "00:03:18,840",
				"to": "00:03:20,840"
			},
			"offsets": {
				"from": 198840,
				"to": 200840
			},
			"text": "我今天代到第一句金句"
		},
		{
			"timestamps": {
				"from": "00:03:20,840",
				"to": "00:03:22,680"
			},
			"offsets": {
				"from": 200840,
				"to": 202680
			},
			"text": "很開心"
		},
		{
			"timestamps": {
				"from": "00:03:22,680",
				"to": "00:03:25,240"
			},
			"offsets": {
				"from": 202680,
				"to": 205240
			},
			"text": "現在這個人對音樂"
		},
		{
			"timestamps": {
				"from": "00:03:25,240",
				"to": "00:03:27,720"
			},
			"offsets": {
				"from": 205240,
				"to": 207720
			},
			"text": "是不是還有那股熱情在這裏"
		},
		{
			"timestamps": {
				"from": "00:03:27,720",
				"to": "00:03:29,560"
			},
			"offsets": {
				"from": 207720,
				"to": 209560
			},
			"text": "我對音樂一向都有熱情"
		},
		{
			"timestamps": {
				"from": "00:03:29,560",
				"to": "00:03:31,440"
			},
			"offsets": {
				"from": 209560,
				"to": 211440
			},
			"text": "你很喜歡音樂"
		},
		{
			"timestamps": {
				"from": "00:03:31,440",
				"to": "00:03:33,440"
			},
			"offsets": {
				"from": 211440,
				"to": 213440
			},
			"text": "音樂的過程裏"
		},
		{
			"timestamps": {
				"from": "00:03:33,440",
				"to": "00:03:35,840"
			},
			"offsets": {
				"from": 213440,
				"to": 215840
			},
			"text": "現在是很多時候在香港樂壇裏"
		},
		{
			"timestamps": {
				"from": "00:03:35,840",
				"to": "00:03:37,160"
			},
			"offsets": {
				"from": 215840,
				"to": 217160
			},
			"text": "我直說我的感受"
		},
		{
			"timestamps": {
				"from": "00:03:37,160",
				"to": "00:03:39,240"
			},
			"offsets": {
				"from": 217160,
				"to": 219240
			},
			"text": "但可能對其他人會不公平"
		},
		{
			"timestamps": {
				"from": "00:03:39,240",
				"to": "00:03:41,240"
			},
			"offsets": {
				"from": 219240,
				"to": 221240
			},
			"text": "其實自己後輪根本沒有著火"
		},
		{
			"timestamps": {
				"from": "00:03:41,240",
				"to": "00:03:43,240"
			},
			"offsets": {
				"from": 221240,
				"to": 223240
			},
			"text": "但覺得自己後輪著火"
		},
		{
			"timestamps": {
				"from": "00:03:43,240",
				"to": "00:03:46,240"
			},
			"offsets": {
				"from": 223240,
				"to": 226240
			},
			"text": "人家叫做事時就想著自己後輪"
		},
		{
			"timestamps": {
				"from": "00:03:46,240",
				"to": "00:03:49,240"
			},
			"offsets": {
				"from": 226240,
				"to": 229240
			},
			"text": "變成做事時很難專注"
		},
		{
			"timestamps": {
				"from": "00:03:49,240",
				"to": "00:03:53,240"
			},
			"offsets": {
				"from": 229240,
				"to": 233240
			},
			"text": "有時做事靈感和集中度"
		},
		{
			"timestamps": {
				"from": "00:03:53,240",
				"to": "00:03:55,240"
			},
			"offsets": {
				"from": 233240,
				"to": 235240
			},
			"text": "其實只是集中四天搞定"
		},
		{
			"timestamps": {
				"from": "00:03:55,240",
				"to": "00:03:57,240"
			},
			"offsets": {
				"from": 235240,
				"to": 237240
			},
			"text": "但你整個人都覺得後輪著火"
		},
		{
			"timestamps": {
				"from": "00:03:57,240",
				"to": "00:03:59,240"
			},
			"offsets": {
				"from": 237240,
				"to": 239240
			},
			"text": "那裡少了一隻羊、少了一隻牛"
		},
		{
			"timestamps": {
				"from": "00:03:59,240",
				"to": "00:04:01,240"
			},
			"offsets": {
				"from": 239240,
				"to": 241240
			},
			"text": "你很難專注到做事"
		},
		{
			"timestamps": {
				"from": "00:04:01,240",
				"to": "00:04:03,240"
			},
			"offsets": {
				"from": 241240,
				"to": 243240
			},
			"text": "有沒有新歌?"
		},
		{
			"timestamps": {
				"from": "00:04:03,240",
				"to": "00:04:05,240"
			},
			"offsets": {
				"from": 243240,
				"to": 245240
			},
			"text": "我想新歌都會有些"
		},
		{
			"timestamps": {
				"from": "00:04:05,240",
				"to": "00:04:07,240"
			},
			"offsets": {
				"from": 245240,
				"to": 247240
			},
			"text": "但如果現在做新歌就沒有了"
		},
		{
			"timestamps": {
				"from": "00:04:07,240",
				"to": "00:04:12,240"
			},
			"offsets": {
				"from": 247240,
				"to": 252240
			},
			"text": "你自己得不得閒呢"
		},
		{
			"timestamps": {
				"from": "00:04:12,240",
				"to": "00:04:15,240"
			},
			"offsets": {
				"from": 252240,
				"to": 255240
			},
			"text": "我有好聽的歌 我根本三個小時不用錄了"
		},
		{
			"timestamps": {
				"from": "00:04:15,240",
				"to": "00:04:18,240"
			},
			"offsets": {
				"from": 255240,
				"to": 258240
			},
			"text": "以我今天的促藝"
		},
		{
			"timestamps": {
				"from": "00:04:18,240",
				"to": "00:04:22,240"
			},
			"offsets": {
				"from": 258240,
				"to": 262240
			},
			"text": "我沒有退步 我計算有進步"
		},
		{
			"timestamps": {
				"from": "00:04:22,240",
				"to": "00:04:23,240"
			},
			"offsets": {
				"from": 262240,
				"to": 263240
			},
			"text": "我唱K"
		},
		{
			"timestamps": {
				"from": "00:04:23,240",
				"to": "00:04:26,240"
			},
			"offsets": {
				"from": 263240,
				"to": 266240
			},
			"text": "你一叫他 他立刻給你吧"
		},
		{
			"timestamps": {
				"from": "00:04:26,240",
				"to": "00:04:28,240"
			},
			"offsets": {
				"from": 266240,
				"to": 268240
			},
			"text": "那些填詞人 我想也是三個小時之內"
		},
		{
			"timestamps": {
				"from": "00:04:28,240",
				"to": "00:04:30,240"
			},
			"offsets": {
				"from": 268240,
				"to": 270240
			},
			"text": "林夕是消失的"
		},
		{
			"timestamps": {
				"from": "00:04:30,240",
				"to": "00:04:31,240"
			},
			"offsets": {
				"from": 270240,
				"to": 271240
			},
			"text": "聽我的電話"
		},
		{
			"timestamps": {
				"from": "00:04:31,240",
				"to": "00:04:33,240"
			},
			"offsets": {
				"from": 271240,
				"to": 273240
			},
			"text": "消失的填詞人"
		},
		{
			"timestamps": {
				"from": "00:04:33,240",
				"to": "00:04:34,240"
			},
			"offsets": {
				"from": 273240,
				"to": 274240
			},
			"text": "不是消失的我人"
		},
		{
			"timestamps": {
				"from": "00:04:34,240",
				"to": "00:04:35,520"
			},
			"offsets": {
				"from": 274240,
				"to": 275520
			},
			"text": "傑仁之人"
		},
		{
			"timestamps": {
				"from": "00:04:35,520",
				"to": "00:04:37,320"
			},
			"offsets": {
				"from": 275520,
				"to": 277320
			},
			"text": "雷仲德打麻雀就回覆"
		},
		{
			"timestamps": {
				"from": "00:04:37,320",
				"to": "00:04:38,340"
			},
			"offsets": {
				"from": 277320,
				"to": 278340
			},
			"text": "我的那些不回覆"
		},
		{
			"timestamps": {
				"from": "00:04:38,340",
				"to": "00:04:40,900"
			},
			"offsets": {
				"from": 278340,
				"to": 280900
			},
			"text": "老實說 如果黎明鏗演唱會"
		},
		{
			"timestamps": {
				"from": "00:04:40,900",
				"to": "00:04:43,460"
			},
			"offsets": {
				"from": 280900,
				"to": 283460
			},
			"text": "我們都希望聽很多舊的歌"
		},
		{
			"timestamps": {
				"from": "00:04:43,460",
				"to": "00:04:46,520"
			},
			"offsets": {
				"from": 283460,
				"to": 286520
			},
			"text": "你叫雷仲德寫新歌出來"
		},
		{
			"timestamps": {
				"from": "00:04:46,520",
				"to": "00:04:47,800"
			},
			"offsets": {
				"from": 286520,
				"to": 287800
			},
			"text": "我寫包單"
		},
		{
			"timestamps": {
				"from": "00:04:47,800",
				"to": "00:04:49,340"
			},
			"offsets": {
				"from": 287800,
				"to": 289340
			},
			"text": "你叫他寫完出來"
		},
		{
			"timestamps": {
				"from": "00:04:49,340",
				"to": "00:04:50,880"
			},
			"offsets": {
				"from": 289340,
				"to": 290880
			},
			"text": "大家投票了"
		},
		{
			"timestamps": {
				"from": "00:04:50,880",
				"to": "00:04:51,900"
			},
			"offsets": {
				"from": 290880,
				"to": 291900
			},
			"text": "什麼事"
		},
		{
			"timestamps": {
				"from": "00:04:51,900",
				"to": "00:04:52,920"
			},
			"offsets": {
				"from": 291900,
				"to": 292920
			},
			"text": "投什麼事"
		},
		{
			"timestamps": {
				"from": "00:04:52,920",
				"to": "00:04:54,460"
			},
			"offsets": {
				"from": 292920,
				"to": 294460
			},
			"text": "終於舊還是新"
		},
		{
			"timestamps": {
				"from": "00:04:54,460",
				"to": "00:04:56,760"
			},
			"offsets": {
				"from": 294460,
				"to": 296760
			},
			"text": "意思應該都是"
		},
		{
			"timestamps": {
				"from": "00:04:56,760",
				"to": "00:04:58,040"
			},
			"offsets": {
				"from": 296760,
				"to": 298040
			},
			"text": "不要搞新事了"
		},
		{
			"timestamps": {
				"from": "00:04:58,040",
				"to": "00:04:59,840"
			},
			"offsets": {
				"from": 298040,
				"to": 299840
			},
			"text": "我也覺得是"
		},
		{
			"timestamps": {
				"from": "00:04:59,840",
				"to": "00:05:01,880"
			},
			"offsets": {
				"from": 299840,
				"to": 301880
			},
			"text": "有新事物一早就給你"
		},
		{
			"timestamps": {
				"from": "00:05:01,880",
				"to": "00:05:03,680"
			},
			"offsets": {
				"from": 301880,
				"to": 303680
			},
			"text": "你不會等你叫才給"
		},
		{
			"timestamps": {
				"from": "00:05:03,680",
				"to": "00:05:08,440"
			},
			"offsets": {
				"from": 303680,
				"to": 308440
			},
			"text": "你明白什麼 很多時候等你叫才讓老夫老車離婚"
		},
		{
			"timestamps": {
				"from": "00:05:08,440",
				"to": "00:05:12,680"
			},
			"offsets": {
				"from": 308440,
				"to": 312680
			},
			"text": "對 作歌人聽到了 如果有好東西"
		},
		{
			"timestamps": {
				"from": "00:05:12,680",
				"to": "00:05:15,920"
			},
			"offsets": {
				"from": 312680,
				"to": 315920
			},
			"text": "自動自覺 人的情緒是否想說"
		},
		{
			"timestamps": {
				"from": "00:05:15,920",
				"to": "00:05:20,200"
			},
			"offsets": {
				"from": 315920,
				"to": 320200
			},
			"text": "你喝杯湯給我喝 說當你口乾"
		},
		{
			"timestamps": {
				"from": "00:05:20,200",
				"to": "00:05:22,440"
			},
			"offsets": {
				"from": 320200,
				"to": 322440
			},
			"text": "突然有人又拿出來"
		},
		{
			"timestamps": {
				"from": "00:05:22,440",
				"to": "00:05:24,600"
			},
			"offsets": {
				"from": 322440,
				"to": 324600
			},
			"text": "突然有人喝杯湯給你 這個人真好"
		},
		{
			"timestamps": {
				"from": "00:05:24,600",
				"to": "00:05:28,680"
			},
			"offsets": {
				"from": 324600,
				"to": 328680
			},
			"text": "我挺喜歡和黎明聊天 他真的有那句說"
		},
		{
			"timestamps": {
				"from": "00:05:28,680",
				"to": "00:05:32,680"
			},
			"offsets": {
				"from": 328680,
				"to": 332680
			},
			"text": "不能說的 都說了"
		},
		{
			"timestamps": {
				"from": "00:05:32,680",
				"to": "00:05:34,680"
			},
			"offsets": {
				"from": 332680,
				"to": 334680
			},
			"text": "沒什麼不能說的"
		},
		{
			"timestamps": {
				"from": "00:05:34,680",
				"to": "00:05:38,020"
			},
			"offsets": {
				"from": 334680,
				"to": 338020
			},
			"text": "這條命是這麼多的了"
		}
	]
}
