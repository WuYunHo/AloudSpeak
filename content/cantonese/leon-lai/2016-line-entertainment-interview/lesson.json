{
  "id": "leon-lai-2016-line-entertainment-interview",
  "title": "黎明《一綫娛樂》專訪",
  "speaker": "黎明（Leon Lai）",
  "category": "粵語訪談",
  "level": "粵語",
  "minutes": 6,
  "sourceUrl": "https://www.bilibili.com/video/BV1Qs411z7hp/",
  "segments": [
    {
      "id": 9001,
      "start": 0,
      "end": 4,
      "text": "其實我主持咗咁耐嘅《一綫娛樂》",
      "translation": "其实我主持了这么久的《一线娱乐》"
    },
    {
      "id": 9002,
      "start": 4,
      "end": 6,
      "text": "終於畀我等到呢一日喇",
      "translation": "终于让我等到这一天了"
    },
    {
      "id": 9003,
      "start": 6,
      "end": 8,
      "text": "就係同我嘅偶像黎明做訪問",
      "translation": "就是同我的偶像黎明做访问"
    },
    {
      "id": 9004,
      "start": 8,
      "end": 9,
      "text": "所以如果一陣",
      "translation": "所以如果一会儿"
    },
    {
      "id": 9005,
      "start": 9,
      "end": 11,
      "text": "有時我會傾偈嘅對住偶像",
      "translation": "有时我会对着偶像聊天"
    },
    {
      "id": 9006,
      "start": 11,
      "end": 13,
      "text": "唔緊要 你傾偈我會畀你更輕",
      "translation": "不要紧 你聊天我会给你更轻松"
    },
    {
      "id": 9007,
      "start": 13,
      "end": 14,
      "text": "你一定要細量",
      "translation": "你一定要商量"
    },
    {
      "id": 9008,
      "start": 14,
      "end": 16,
      "text": "大家飛咗之後 剪咗就唔會有",
      "translation": "大家飞了之后 剪了就不会有"
    },
    {
      "id": 9009,
      "start": 16,
      "end": 18,
      "text": "Leon咁好 我打算開始訪問",
      "translation": "Leon这么好 我打算开始访问"
    },
    {
      "id": 9010,
      "start": 18,
      "end": 20,
      "text": "究竟Leon籌備緊嘅演唱會",
      "translation": "究竟Leon筹备紧的演唱会"
    },
    {
      "id": 9011,
      "start": 20,
      "end": 22,
      "text": "連唱地都特別過人",
      "translation": "连唱地都特别过人"
    },
    {
      "id": 9012,
      "start": 22,
      "end": 24,
      "text": "我覺得唔同紅館",
      "translation": "我觉得不同红馆"
    },
    {
      "id": 9013,
      "start": 24,
      "end": 26,
      "text": "起碼有啲新嘅嘗試",
      "translation": "起码有些新的尝试"
    },
    {
      "id": 9014,
      "start": 26,
      "end": 27,
      "text": "有新嘅嘗試嚟講",
      "translation": "有新的尝试来说"
    },
    {
      "id": 9015,
      "start": 27,
      "end": 29,
      "text": "你作為一個表演者嗰陣時",
      "translation": "你作为一个表演者那时候"
    },
    {
      "id": 9016,
      "start": 29,
      "end": 31,
      "text": "喺唔同的新嘅地方",
      "translation": "在不同的新的地方"
    },
    {
      "id": 9017,
      "start": 31,
      "end": 34,
      "text": "你會有神秘感",
      "translation": "你会有神秘感"
    },
    {
      "id": 9018,
      "start": 34,
      "end": 35,
      "text": "自己對那件事",
      "translation": "自己对那件事"
    },
    {
      "id": 9019,
      "start": 35,
      "end": 36,
      "text": "新鮮感",
      "translation": "新鲜感"
    },
    {
      "id": 9020,
      "start": 36,
      "end": 37,
      "text": "恐懼",
      "translation": "恐惧"
    },
    {
      "id": 9021,
      "start": 37,
      "end": 39,
      "text": "網上放的那條片",
      "translation": "网上放的那条片"
    },
    {
      "id": 9022,
      "start": 39,
      "end": 40,
      "text": "係唔係你的構思",
      "translation": "系不是你的构思"
    },
    {
      "id": 9023,
      "start": 40,
      "end": 41,
      "text": "係我構思",
      "translation": "是我构思"
    },
    {
      "id": 9024,
      "start": 41,
      "end": 42,
      "text": "好簡單",
      "translation": "好简单"
    },
    {
      "id": 9025,
      "start": 42,
      "end": 43,
      "text": "八點鐘",
      "translation": "八点钟"
    },
    {
      "id": 9026,
      "start": 43,
      "end": 45,
      "text": "但又有恐龍",
      "translation": "但又有恐龙"
    },
    {
      "id": 9027,
      "start": 45,
      "end": 46,
      "text": "又有水果",
      "translation": "又有水果"
    },
    {
      "id": 9028,
      "start": 46,
      "end": 47,
      "text": "可能他知道我演出",
      "translation": "可能他知道我演出"
    },
    {
      "id": 9029,
      "start": 47,
      "end": 48,
      "text": "有啲嘢會出現",
      "translation": "有些东西会出现"
    },
    {
      "id": 9030,
      "start": 48,
      "end": 49,
      "text": "佢哋自己加下去",
      "translation": "他们自己加下去"
    },
    {
      "id": 9031,
      "start": 49,
      "end": 51,
      "text": "你不可以就這樣一條片",
      "translation": "你不可以就这样一条片"
    },
    {
      "id": 9032,
      "start": 51,
      "end": 53,
      "text": "但沒問題做乜嘢事",
      "translation": "但没问题做什么事"
    },
    {
      "id": 9033,
      "start": 53,
      "end": 55,
      "text": "好像喺社交網站",
      "translation": "好像在社交网站"
    },
    {
      "id": 9034,
      "start": 55,
      "end": 56,
      "text": "Leon一係不玩",
      "translation": "Leon一系不玩"
    },
    {
      "id": 9035,
      "start": 56,
      "end": 58,
      "text": "一玩就神級人人like爆",
      "translation": "一玩就神级人人like爆"
    },
    {
      "id": 9036,
      "start": 58,
      "end": 61.68,
      "text": "有訪問都不多做的神秘天王變身post片王",
      "translation": "有访问都不多做的神秘天王变身post片王"
    },
    {
      "id": 9037,
      "start": 61.68,
      "end": 64.68,
      "text": "社交網絡有啲嘢你唔使太多包裝",
      "translation": "社交网络有些东西你不需要太多包装"
    },
    {
      "id": 9038,
      "start": 64.68,
      "end": 66.68,
      "text": "你可以接受真實的嘢",
      "translation": "你可以接受真实的东西"
    },
    {
      "id": 9039,
      "start": 66.68,
      "end": 69.4,
      "text": "你自己有自己一個底線",
      "translation": "你自己有自己一个底线"
    },
    {
      "id": 9040,
      "start": 69.4,
      "end": 70.04,
      "text": "係唔係",
      "translation": "系不是"
    },
    {
      "id": 9041,
      "start": 70.04,
      "end": 71.12,
      "text": "那就OK咗",
      "translation": "那就OK了"
    },
    {
      "id": 9042,
      "start": 71.12,
      "end": 72.52,
      "text": "沒咁多製造",
      "translation": "没这么多制造"
    },
    {
      "id": 9043,
      "start": 72.52,
      "end": 73.8,
      "text": "以前我不玩的原因係",
      "translation": "以前我不玩的原因系"
    },
    {
      "id": 9044,
      "start": 73.8,
      "end": 76.4,
      "text": "以前我自己對呢個睇法和感受唔同",
      "translation": "以前我自己对这个看法和感受不同"
    },
    {
      "id": 9045,
      "start": 76.4,
      "end": 77.4,
      "text": "今日玩的原因係",
      "translation": "今天玩的原因系"
    },
    {
      "id": 9046,
      "start": 77.4,
      "end": 79.32,
      "text": "因為我自己找到另一個方法可以share",
      "translation": "因为我自己找到另一个方法可以share"
    },
    {
      "id": 9047,
      "start": 79.32,
      "end": 80.8,
      "text": "我從來都好想share我的嘢",
      "translation": "我从来都好想share我的东西"
    },
    {
      "id": 9048,
      "start": 80.8,
      "end": 82.2,
      "text": "和我自己鍾意我的人",
      "translation": "和我自己喜欢我的人"
    },
    {
      "id": 9049,
      "start": 82.2,
      "end": 83.8,
      "text": "大家去溝通和傾偈",
      "translation": "大家去沟通和聊天"
    },
    {
      "id": 9050,
      "start": 84.6,
      "end": 85.32,
      "text": "那",
      "translation": "那"
    },
    {
      "id": 9051,
      "start": 85.32,
      "end": 88.76,
      "text": "只不過以前你太多嘢",
      "translation": "只不过以前你太多东西"
    },
    {
      "id": 9052,
      "start": 88.76,
      "end": 90.92,
      "text": "你覺得冇呢個空間 冇呢個時間",
      "translation": "你觉得没有这个空间 没有这个时间"
    },
    {
      "id": 9053,
      "start": 90.92,
      "end": 94.88,
      "text": "包括你做每件事喺外面都係被狗隨隊跟著你",
      "translation": "包括你做每件事在外面都系被狗随队跟著你"
    },
    {
      "id": 9054,
      "start": 94.88,
      "end": 102.04,
      "text": "但當嗰個新媒體或者所謂大家的自由媒體發達得好厲害嗰陣時",
      "translation": "但当那个新媒体或者所谓大家的自由媒体发达得好厉害那时候"
    },
    {
      "id": 9055,
      "start": 102.04,
      "end": 104.4,
      "text": "自然這件事就開始減少",
      "translation": "自然这件事就开始减少"
    },
    {
      "id": 9056,
      "start": 104.4,
      "end": 106.84,
      "text": "減少嗰陣時 相對嚟講",
      "translation": "减少那时候 相对来说"
    },
    {
      "id": 9057,
      "start": 106.84,
      "end": 109.96,
      "text": "你開始個人周邊冇咁多壓力",
      "translation": "你开始个人周边没有这么多压力"
    },
    {
      "id": 9058,
      "start": 109.96,
      "end": 112.68,
      "text": "你就可以放鬆一啲跟大家分享一下嘢",
      "translation": "你就可以放松一些跟大家分享一下东西"
    },
    {
      "id": 9059,
      "start": 112.68,
      "end": 113.8,
      "text": "係這樣的意思",
      "translation": "系这样的意思"
    },
    {
      "id": 9060,
      "start": 113.8,
      "end": 116.04,
      "text": "因為説真係 以前真係覺得",
      "translation": "因为说真的 以前真的觉得"
    },
    {
      "id": 9061,
      "start": 116.04,
      "end": 118.08,
      "text": "黎明給了我哋好多神秘感",
      "translation": "黎明给了我们很多神秘感"
    },
    {
      "id": 9062,
      "start": 118.08,
      "end": 118.8,
      "text": "因為你唔係",
      "translation": "因为你不是"
    },
    {
      "id": 9063,
      "start": 118.8,
      "end": 119.8,
      "text": "我唔係想神秘的",
      "translation": "我不是想神秘的"
    },
    {
      "id": 9064,
      "start": 119.8,
      "end": 120.3,
      "text": "係啊",
      "translation": "系啊"
    },
    {
      "id": 9065,
      "start": 120.3,
      "end": 120.8,
      "text": "我唔係神秘的",
      "translation": "我不是神秘的"
    },
    {
      "id": 9066,
      "start": 120.8,
      "end": 123.48,
      "text": "你明明我係一個走投無路",
      "translation": "你明明我是一个走投无路"
    },
    {
      "id": 9067,
      "start": 123.48,
      "end": 125.44,
      "text": "不停逃跑的 躲起嚟的人",
      "translation": "不停逃跑的 躲起来的人"
    },
    {
      "id": 9068,
      "start": 125.44,
      "end": 127.44,
      "text": "我好鍾意吃嗰個大排檔的",
      "translation": "我好喜欢吃那个大排档的"
    },
    {
      "id": 9069,
      "start": 128.44,
      "end": 129.96,
      "text": "吃個大排檔",
      "translation": "吃个大排档"
    },
    {
      "id": 9070,
      "start": 129.96,
      "end": 131.36,
      "text": "我一個人去吃個大排檔",
      "translation": "我一个人去吃个大排档"
    },
    {
      "id": 9071,
      "start": 131.36,
      "end": 132.88,
      "text": "我平時都有呢個習慣",
      "translation": "我平时都有这个习惯"
    },
    {
      "id": 9072,
      "start": 132.88,
      "end": 134.88,
      "text": "但你剛好過了時間去吃嗰陣時",
      "translation": "但你刚好过了时间去吃那时候"
    },
    {
      "id": 9073,
      "start": 134.88,
      "end": 136.48,
      "text": "如果他拍照嗰陣時",
      "translation": "如果他拍照那时候"
    },
    {
      "id": 9074,
      "start": 136.48,
      "end": 137.44,
      "text": "他會寫乜嘢 caption呢",
      "translation": "他会写什么 caption呢"
    },
    {
      "id": 9075,
      "start": 137.44,
      "end": 137.88,
      "text": "下底呢",
      "translation": "下底呢"
    },
    {
      "id": 9076,
      "start": 137.88,
      "end": 138.96,
      "text": "我想問問一下你",
      "translation": "我想问问一下你"
    },
    {
      "id": 9077,
      "start": 138.96,
      "end": 140.32,
      "text": "如果我要買嗰陣時",
      "translation": "如果我要买那时候"
    },
    {
      "id": 9078,
      "start": 140.32,
      "end": 141.16,
      "text": "一定係",
      "translation": "一定系"
    },
    {
      "id": 9079,
      "start": 141.16,
      "end": 142.72,
      "text": "呢個 caption係唔會好的咗",
      "translation": "这个 caption系不会好的了"
    },
    {
      "id": 9080,
      "start": 142.72,
      "end": 144.72,
      "text": "你會傷害了好多人",
      "translation": "你会伤害了很多人"
    },
    {
      "id": 9081,
      "start": 144.72,
      "end": 147.72,
      "text": "所以我而家睇你社交網站分享的",
      "translation": "所以我现在看你社交网站分享的"
    },
    {
      "id": 9082,
      "start": 147.72,
      "end": 150.72,
      "text": "覺得這係真正的黎明",
      "translation": "觉得这系真正的黎明"
    },
    {
      "id": 9083,
      "start": 150.72,
      "end": 153.72,
      "text": "你唔好覺得這係真係",
      "translation": "你不要觉得这系真的"
    },
    {
      "id": 9084,
      "start": 153.72,
      "end": 155.72,
      "text": "有啲人都覺得係假的",
      "translation": "有些人都觉得系假的"
    },
    {
      "id": 9085,
      "start": 155.72,
      "end": 157.72,
      "text": "總之這係生活的程式裏面",
      "translation": "总之这系生活的程式里面"
    },
    {
      "id": 9086,
      "start": 157.72,
      "end": 158.72,
      "text": "它的情況許可",
      "translation": "它的情况许可"
    },
    {
      "id": 9087,
      "start": 158.72,
      "end": 161.72,
      "text": "而你的情緒又係想做的",
      "translation": "而你的情绪又系想做的"
    },
    {
      "id": 9088,
      "start": 161.72,
      "end": 162.72,
      "text": "你就做吧",
      "translation": "你就做吧"
    },
    {
      "id": 9089,
      "start": 162.72,
      "end": 166.72,
      "text": "講回我哋觀眾去感受你的金句",
      "translation": "说回我们观众去感受你的金句"
    },
    {
      "id": 9090,
      "start": 166.72,
      "end": 169.72,
      "text": "你有一句核心的內圍等於核心的外圍",
      "translation": "你有一句核心的内围等于核心的外围"
    },
    {
      "id": 9091,
      "start": 169.72,
      "end": 171.72,
      "text": "我其實理解了好耐都聽唔明",
      "translation": "我其实理解了好耐都听不明白"
    },
    {
      "id": 9092,
      "start": 171.72,
      "end": 173.72,
      "text": "聽唔明 我都知道你解釋了好多次",
      "translation": "听不明白 我都知道你解释了很多次"
    },
    {
      "id": 9093,
      "start": 173.72,
      "end": 175.34,
      "text": "但可不可以再向我哋",
      "translation": "但可不可以再向我们"
    },
    {
      "id": 9094,
      "start": 175.34,
      "end": 176.88,
      "text": "不 我想嗰個",
      "translation": "不 我想那个"
    },
    {
      "id": 9095,
      "start": 176.88,
      "end": 178.56,
      "text": "你一講呢個話之後",
      "translation": "你一说这个话之后"
    },
    {
      "id": 9096,
      "start": 178.56,
      "end": 180.48,
      "text": "我就開始覺得你做過功課咗",
      "translation": "我就开始觉得你做过功课了"
    },
    {
      "id": 9097,
      "start": 180.48,
      "end": 181.26,
      "text": "OK",
      "translation": "OK"
    },
    {
      "id": 9098,
      "start": 183.26,
      "end": 184.26,
      "text": "其實",
      "translation": "其实"
    },
    {
      "id": 9099,
      "start": 185.56,
      "end": 186.48,
      "text": "好多嘢",
      "translation": "很多东西"
    },
    {
      "id": 9100,
      "start": 186.48,
      "end": 188.48,
      "text": "我覺得睇嘢唔係睇一面",
      "translation": "我觉得看东西不是看一面"
    },
    {
      "id": 9101,
      "start": 189.58,
      "end": 191.72,
      "text": "係睇幾個角度",
      "translation": "系看几个角度"
    },
    {
      "id": 9102,
      "start": 191.72,
      "end": 194.14,
      "text": "那你核心的內圍和外圍嚟講",
      "translation": "那你核心的内围和外围来说"
    },
    {
      "id": 9103,
      "start": 194.14,
      "end": 195.98,
      "text": "就係你站喺哪個角度",
      "translation": "就是你站在哪个角度"
    },
    {
      "id": 9104,
      "start": 195.98,
      "end": 200.16,
      "text": "你永遠站喺一個護照的正面",
      "translation": "你永远站在一个护照的正面"
    },
    {
      "id": 9105,
      "start": 200.16,
      "end": 202.56,
      "text": "你就會睇到嗰個國輝",
      "translation": "你就会看到那个国辉"
    },
    {
      "id": 9106,
      "start": 202.56,
